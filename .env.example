SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_MACOS_SIGN_IN_ENABLED=false
SUPABASE_PROFILE_TABLES_ENABLED=false
APPLE_SIGN_IN_ENABLED=false
APPLE_WEB_REDIRECT_URL=
APPLE_WEB_CLIENT_ID=
AI_REMOTE_ENABLED=true
# Leave both unset to use Google's public AdMob TEST rewarded ad unit IDs.
ADMOB_REWARDED_AD_UNIT_ID_ANDROID=
ADMOB_REWARDED_AD_UNIT_ID_IOS=
# Leave unset and push notifications stay inert. See Firebase Console >
# Project settings > General for these values, per registered app.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS=
FIREBASE_IOS_BUNDLE_ID=
